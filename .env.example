# Supabase Postgres connection (pooler URL from Supabase project settings)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Schema that holds the landing/bronze data
DB_SCHEMA=bronze

# Vector DB.
# Leave QDRANT_URL empty to run Qdrant embedded against ./qdrant_data (no Docker).
# Set it to http://localhost:6333 to use the Docker container in docker-compose.yml.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=meva_events

# Embeddings. EMBED_DIM must match the model (bge-base = 768, bge-large = 1024).
# Changing either means re-creating the collection from scratch.
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIM=768

# LLM. OpenRouter and Ollama both speak the OpenAI API, so only these change.
#
#   OpenRouter (hosted, many models incl. free ones — see openrouter.ai/models):
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODEL=<vendor>/<model>        e.g. a ":free" model to avoid charges
#     LLM_API_KEY=sk-or-...
#
#   Ollama (local, free, offline):
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=qwen3:4b
#     LLM_API_KEY=                      (not used)
#
# Leave LLM_MODEL empty to skip the LLM entirely; answers fall back to a plain
# summary of the top match.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
#nvidia/nemotron-3-ultra-550b-a55b:free 
#nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
#liquid/lfm-2.5-2.6b:free
LLM_API_KEY=
